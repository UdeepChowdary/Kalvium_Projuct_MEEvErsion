# Database connection (SQLite file-based database)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentic server-side role sessions
JWT_SECRET="campus_event_hub_secure_key_2026_secret"

# Optional: Google Gemini API Key for online multimodal poster analysis
GEMINI_API_KEY=""

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# DEMO MODE: "true" displays the 1-click evaluation switcher bar. "false" hides it completely in production.
NEXT_PUBLIC_DEMO_MODE="true"
