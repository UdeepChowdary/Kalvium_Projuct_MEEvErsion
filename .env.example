# Database connection (SQLite file-based database)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentic server-side role sessions
JWT_SECRET="campus_event_hub_secure_key_2026_secret"

# Optional: Google Gemini API Key for online multimodal poster analysis
# If not provided or empty, the application uses its built-in intelligent local OCR/parser
GEMINI_API_KEY=""

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# DEMO MODE: set to "true" to display the 1-click evaluation switcher bar, or "false" for strict production mode
NEXT_PUBLIC_DEMO_MODE="true"
